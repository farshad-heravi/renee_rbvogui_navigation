<?xml version="1.0" ?>
<!--
  renee_room: rectangular room around the Campetella CRC as installed in the
  real lab (GENERATED geometry - numbers below are the source of truth).

  The Campetella meshes are spawned by world_spawn_entrypoint.sh
  (campetella_sim spawn_campetella.launch.py) at x=0 y=0 z=1.00 yaw=0
  (world_poses.sh), so the transversal beam (CAD z -0.20..0) rests at
  z 0.80-1.00 on the two stands below. CAD frame = world frame here:
  beam along x (-2.846..0.321), extraction arm towards -y (to -1.214).

  Stands modelled from a photo of the real setup; fence contour measured
  from the real-robot SLAM map maps/real_robot_environment_v4 (0.1 m res.):
  * two triangular wheeled aluminium stands under the beam at x=-2.775
    (end-cap end) and x=0.0 (carriage / extraction-arm end): 2 vertical posts
    (x +-0.15) under the beam, each with a diagonal brace to a floor rail
    reaching y=-0.95 (extraction-arm side), 4 wheels, top bar at z=0.80.
  * 0.35 m high, 0.1 m thick wooden pallet fences (~0.1 m above the rover
    lidar plane z=0.256) forming a closed asymmetric H (centrelines):
      end-cap bar  x -3.05..-2.50, y -1.15..0.45
      crossbar     x -2.50..-0.25, y -0.35..0.20 (under the beam)
      carriage bar x -0.25..0.25,  y -1.20..0.45
    The bars reach 0.25 m past the crossbar on +y but 0.8-0.85 m on -y
    (extraction-arm side): the crossbar is off-centre.
  Room: passages from the H outer boundary (x -3.10..0.30, y -1.25..0.50):
  behind (-x) 1.2 m, front (+x) 1.5 m, sides 1.5 m =>
    inner wall faces x = -4.30 / 1.80, y = -2.75 / 2.00
    interior 6.10 m (x) x 4.75 m (y); walls 0.1 m thick, 1.5 m high.
  The mobile robot spawns in the +y passage (world_poses.sh).
-->
<sdf version="1.8">
  <world name="renee_room">
    <physics type='ode'>
      <max_step_size>0.02</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>50</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='libgz-sim-physics-system.so'/>
    <plugin name='gz::sim::systems::UserCommands' filename='libgz-sim-user-commands-system.so'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='libgz-sim-scene-broadcaster-system.so'/>
    <plugin name="gz::sim::systems::Sensors" filename="libgz-sim-sensors-system.so">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="libgz-sim-imu-system.so"/>
    <plugin name="gz::sim::systems::NavSat" filename="libgz-sim-navsat-system.so"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Triangular wheeled stands under the Campetella beam. -->
    <model name="campetella_stands"><static>true</static><pose>0 0 0 0 0 0</pose>
      <link name="l">
        <collision name="stand_near_rail0_c"><pose>-2.9250 -0.3750 0.1250 0.0000 0 0</pose><geometry><box><size>0.0500 1.1500 0.0500</size></box></geometry></collision>
        <visual name="stand_near_rail0_v"><pose>-2.9250 -0.3750 0.1250 0.0000 0 0</pose><geometry><box><size>0.0500 1.1500 0.0500</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
        <collision name="stand_near_post0_c"><pose>-2.9250 -0.0865 0.4750 0.0000 0 0</pose><geometry><box><size>0.0500 0.0500 0.6500</size></box></geometry></collision>
        <visual name="stand_near_post0_v"><pose>-2.9250 -0.0865 0.4750 0.0000 0 0</pose><geometry><box><size>0.0500 0.0500 0.6500</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
        <collision name="stand_near_brace0_c"><pose>-2.9250 -0.5182 0.4250 0.5671 0 0</pose><geometry><box><size>0.0400 1.0238 0.0400</size></box></geometry></collision>
        <visual name="stand_near_brace0_v"><pose>-2.9250 -0.5182 0.4250 0.5671 0 0</pose><geometry><box><size>0.0400 1.0238 0.0400</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
        <collision name="stand_near_wheel00_c"><pose>-2.9250 0.2000 0.0500 0 1.5708 0</pose><geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry></collision>
        <visual name="stand_near_wheel00_v"><pose>-2.9250 0.2000 0.0500 0 1.5708 0</pose><geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name="stand_near_wheel01_c"><pose>-2.9250 -0.9500 0.0500 0 1.5708 0</pose><geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry></collision>
        <visual name="stand_near_wheel01_v"><pose>-2.9250 -0.9500 0.0500 0 1.5708 0</pose><geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
