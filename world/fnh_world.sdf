<?xml version="1.0" ?>
<sdf version='1.6'>
  <world name='default'>
    <physics type='ode'>
      <max_step_size>0.02</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>50</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='libgz-sim-physics-system.so'/>
    <plugin name='gz::sim::systems::UserCommands' filename='libgz-sim-user-commands-system.so'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='libgz-sim-scene-broadcaster-system.so'/>
    <plugin name="gz::sim::systems::Sensors" filename="libgz-sim-sensors-system.so">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="libgz-sim-imu-system.so"/>
    <plugin name="gz::sim::systems::NavSat" filename="libgz-sim-navsat-system.so"/>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <shadows>1</shadows>
    </scene>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1.0</direction>
    </light>

    <!-- Robotnik site: Valencia, Spain -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>39.551908</latitude_deg>
      <longitude_deg>-0.468661</longitude_deg>
      <elevation>108</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <model name="ground_plane">
        <static>true</static>
        <link name="link">
            <collision name="collision">
            <geometry>
                <plane>
                <normal>0 0 1</normal>
                </plane>
            </geometry>
            </collision>
            <visual name="visual">
            <geometry>
                <plane>
                <normal>0 0 1</normal>
                <size>100 100</size>
                </plane>
            </geometry>
            <material>
                <ambient>0.8 0.8 0.8 1</ambient>
                <diffuse>0.8 0.8 0.8 1</diffuse>
                <specular>0.8 0.8 0.8 1</specular>
            </material>
            </visual>
        </link>
    </model>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <wind/>

    <model name="origin_axes">
      <static>true</static>
      <link name="linkX">
        <!-- Eje X -->
        <visual name="x_axis">
          <pose>0.5 0 0 0 1.57 0</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient> <!-- Rojo -->
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="linkY">
        <!-- Eje Y -->
        <visual name="y_axis">
          <pose>0 0.5 0 -1.57 0 0</pose> <!-- Invertido con -1.5708 -->
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient> <!-- Verde -->
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="linkZ">
        <!-- Eje Y -->
        <visual name="z_axis">
          <pose>0 0 0.5 0 0 1.57</pose> <!-- Invertido con -1.5708 -->
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient> <!-- Verde -->
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='demo'>
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name='demo_link'>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>file:///fnh_pkgs/src/renee_rbvogui_navigation/mesh/gz_world.stl</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>file:///fnh_pkgs/src/renee_rbvogui_navigation/mesh/gz_world.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>

    <state world_name='default'>
      <sim_time>95 560000000</sim_time>
      <real_time>96 21539812</real_time>
      <wall_time>1633516541 377109527</wall_time>
      <iterations>95560</iterations>
    </state>
    <!--gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>10.4424 7.27736 7.91302 0 0.5498 -2.56</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui-->
  </world>
</sdf>
