<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="table_cube_world">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="libgz-sim-physics-system.so"/>
    <plugin name="gz::sim::systems::UserCommands" filename="libgz-sim-user-commands-system.so"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="libgz-sim-scene-broadcaster-system.so"/>
    <plugin name="gz::sim::systems::Sensors" filename="libgz-sim-sensors-system.so">
    <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <!-- just activate for presentation, otherwise it is not needed -->
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- WALLS aournd the table -->
    <model name="wall_0">
      <static>true</static>
      <pose>4.0 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 8 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 8 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
     <model name="wall_1">
      <static>true</static>
      <pose>-4.0 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 8 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 8 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_2">
      <static>true</static>
      <pose>0 4.0 1.0 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 8 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 8 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_3">
      <static>true</static>
      <pose>0 -4.0 1.0 0 0 -1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 8 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 8 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Four rectangular cart supports.  One north/south pair is aligned with
      the extraction axis (x=0); the other pair is at the free end of the
      transversal axis (x=-2.8455).  Together they form a rectangle, with
      the north and south support centers separated by 1.60 m.
    -->
    <model name="campetella_mapping_cart_supports">
      <static>true</static>
      <pose>1.0 0.0 0.0 0 0 0</pose>

      <link name="extraction_south_support">
        <pose>0.0 -1.15295 0.15 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.50 0.20 0.30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.50 0.20 0.30</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="extraction_north_support">
        <pose>0.0 0.44705 0.15 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.50 0.20 0.30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.50 0.20 0.30</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="transversal_end_south_support">
        <pose>-2.8455 -1.15295 0.15 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.50 0.20 0.30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.50 0.20 0.30</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="transversal_end_north_support">
        <pose>-2.8455 0.44705 0.15 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.50 0.20 0.30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.50 0.20 0.30</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
